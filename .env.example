# Copy to backend/.env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://helpdesk_user:change-me@localhost:5432/helpdesk

# AI - any OpenAI-compatible API (OpenRouter by default)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_API_KEY=your-openrouter-key-here
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_MAX_TOKENS=1500
AI_REQUIRE_STRUCTURED_OUTPUT=true
AI_APP_NAME=EY Helpdesk Capstone

LOG_LEVEL=INFO
