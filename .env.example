# Copy to backend/.env and fill in real values. Never commit .env.
# Either a full URL...
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/helpdesk
# ...or the individual values (used only when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=helpdesk
# DB_USER=postgres
# DB_PASSWORD=change-me

# AI - local Ollama (OpenAI-compatible API). Run: ollama pull qwen2.5:3b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:3b
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_MAX_TOKENS=800

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Tests use a separate database (they drop all tables):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/helpdesk_test
